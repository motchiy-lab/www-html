{
  "name": "www-html-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf .wrangler && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "d1:init": "wrangler d1 execute pv-counter-db --local --file=schema.sql",
    "d1:init:remote": "wrangler d1 execute pv-counter-db --remote --file=schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  }
}
