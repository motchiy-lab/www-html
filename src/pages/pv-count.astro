---
import Main from "../layouts/Main.astro";
const year = new Date().getFullYear();
const month = new Date().getMonth() + 1;
---

<Main pageTitle="プレビューカウンター">
  <section class="section">
    <h2 class="pv-title">{year}年 {month}月 のPV一覧</h2>
    <table>
      <thead>
        <tr>
          <th>ページ</th>
          <th>PV</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="2">スタティック移行のため、リアルタイム集計は停止中またはGoogleアナリティクスをご利用ください。</td>
        </tr>
      </tbody>
    </table>
  </section>
</Main>
