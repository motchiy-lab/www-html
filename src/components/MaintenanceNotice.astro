---
import "./maintenance-notice/maintenance-notice.css";
---

<section
    class="motchiy-maintenance-notice"
    aria-labelledby="motchiy-maintenance-title"
>
    <div class="motchiy-maintenance-notice__container">
        <h2
            id="motchiy-maintenance-title"
            class="motchiy-maintenance-notice__title"
        >
            メンテナンスのお知らせ
        </h2>

        <p class="motchiy-maintenance-notice__text">
            システムメンテナンスを実施します。<br />
            ご不便をおかけしますが、ご理解とご協力をよろしくお願いします。
        </p>

        <a
            href="https://status.motchiy.com/"
            class="motchiy-maintenance-notice__link"
        >
            詳しい情報はこちら
        </a>
    </div>
</section>
